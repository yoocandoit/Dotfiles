/* ---- Import Wallust Rofi colors ---- */
/* @import "~/.config/rofi/wallust/colors-rofi.rasi" */


/* ---- Configuration ---- */

configuration {
    modi:                    "drun,window";
    show-icons:              true;

    display-drun:            " apps";
    display-run:             " term";
    display-filebrowser:     " files";
    display-window:          " window";

    drun-display-format:     "{name}";

    hover-select:             true;

    font:                    "Google Sans Flex Regular 11";

    me-select-entry:         "MouseSecondary";
    me-accept-entry:         "MousePrimary";

    window-format:            "{w} · {c} · {t}";

    icon-theme:               "Colloid";
}


/* ---- Window ---- */

window {
    enabled:                 true;
    fullscreen:              false;

    transparency:             "real";
    cursor:                  "default";

    spacing:                  0px;

    border:                  2px;
    border-radius:             20px;

    location:                 center;
    anchor:                   center;

    width:                   30%;

    background-color:         @background-color;
    border-color:             @border-color;
}


/* ---- Main Box ---- */

mainbox {
    enabled:                 true;

    orientation:             vertical;

    children:                [ "inputbar", "listbox" ];

    background-color:         transparent;
}


/* ---- Inputbar ---- */

inputbar {
    enabled:                 true;

    padding:                 8px;
    margin:                  10px;

    background-color:         transparent;

    border-radius:            0px;

    orientation:              horizontal;

    children:                 [ "entry" ];
}


/* ---- Entry ---- */

entry {
    enabled:                 true;

    expand:                   true;
    width:                    100%;

    padding:                  8px;

    border-radius:            0px;

    background-color:         transparent;

    text-color:               @foreground;

    cursor:                   text;

    placeholder:              "Search";
    placeholder-color:        @normal-foreground;
}


/* ---- Listbox ---- */

listbox {
    spacing:                  0px;

    padding:                  0px 10px 10px 10px;

    background-color:         transparent;

    orientation:              vertical;

    children:                 [ "message", "listview" ];
}


/* ---- Listview ---- */

listview {
    enabled:                  true;

    columns:                  1;
    lines:                    7;

    cycle:                    true;
    dynamic:                  true;

    scrollbar:                false;

    layout:                   vertical;

    fixed-height:             true;
    fixed-columns:             true;

    spacing:                  0px;
    padding:                  0px;

    background-color:         transparent;

    border:                   0px;
}


/* ---- Scrollbar ---- */

scrollbar {
    border:                   0px;

    background-color:         transparent;

    handle-color:             @border-color;
    handle-width:              2px;
}


/* ---- Elements ---- */

element {
    enabled:                  true;

    spacing:                  8px;

    padding:                  8px;

    border-radius:             10px;

    background-color:         transparent;

    cursor:                   pointer;
}


/* Normal */
element normal.normal {
    background-color:        transparent;
    text-color:              @normal-foreground;
}

/* Hover / Mouse selection */
element normal.active {
    background-color:        @active-background;
    text-color:              @active-foreground;
}

/* Urgent */
element normal.urgent {
    background-color:        @urgent-background;
    text-color:              @urgent-foreground;
}

/* Selected */
element selected.normal {
    background-color:        @selected-normal-background;
    text-color:              @selected-normal-foreground;
}

element selected.active {
    background-color:        @selected-active-background;
    text-color:              @selected-active-foreground;
}

element selected.urgent {
    background-color:        @selected-urgent-background;
    text-color:              @selected-urgent-foreground;
}

/* Alternate rows */
element alternate.normal,
element alternate.active,
element alternate.urgent {
    background-color:        transparent;
    text-color:              @alternate-normal-foreground;
}

/* ---- Text ---- */

element-text {
    background-color:         transparent;

    text-color:               inherit;

    cursor:                   inherit;

    vertical-align:            0.5;
    horizontal-align:          0.0;
}


/* ---- Message ---- */

message {
    background-color:         transparent;

    border:                   0px;
}


/* ---- Textbox ---- */

textbox {
    margin:                   10px;

    padding:                  8px;

    background-color:         @alternate-active-background;

    text-color:               @alternate-active-foreground;

    vertical-align:           0.5;
    horizontal-align:         0.5;
}


/* ---- Error Message ---- */

error-message {
    padding:                  8px;

    background-color:         @urgent-background;

    text-color:               @urgent-foreground;
}
